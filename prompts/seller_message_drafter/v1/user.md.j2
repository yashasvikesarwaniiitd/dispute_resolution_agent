<message_kind>{{ ctx.kind }}</message_kind>

<case_reference>{{ ctx.case_ref }}</case_reference>

<approved_facts>
{% for f in ctx.facts -%}
- id: {{ f.fact_id }} | kind: {{ f.kind }} | value: {{ f.rendered | neutralise }}
{% endfor -%}
</approved_facts>

{% if ctx.requested_items -%}
<untrusted_requested_items>
{% for item in ctx.requested_items -%}
- {{ item | neutralise }}
{% endfor -%}
</untrusted_requested_items>
{% endif %}

{% if ctx.open_points -%}
<untrusted_open_points>
{% for p in ctx.open_points -%}
- {{ p | neutralise }}
{% endfor -%}
</untrusted_open_points>
{% endif %}

<next_step>{{ ctx.next_step }}</next_step>

<style>
tone: {{ ctx.style.tone }}
language: {{ ctx.style.language }}
max_words: {{ ctx.style.max_words }}
</style>

Write the message now. Return only the JSON object.
