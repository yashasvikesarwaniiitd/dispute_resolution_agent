<case_facts>
case_ref: {{ b.case_ref }}
shipment_ref: {{ b.facts.shipment_ref }}
claim_ref: {{ b.facts.claim_ref }}
seller_ref: {{ b.facts.seller_ref }}
raised_at: {{ b.facts.raised_at }}
</case_facts>

<deterministic_results>
{{ b.assessment_view | tojson }}
</deterministic_results>

<evidence_items>
{% for item in b.trusted_evidence -%}
- id: {{ item.id | neutralise }} | what: {{ item.label | neutralise }} ({{ item.key | neutralise }}) | status: {{ item.status }} | value: {{ item.value | tojson }}
{% endfor -%}
{% for item in b.untrusted_evidence -%}
- id: {{ item.id | neutralise }} | source: {{ item.source | neutralise }} | source_trust: outside_party | value: see untrusted_evidence block {{ item.id | neutralise }}
{% endfor -%}
</evidence_items>

<citable_ids>
{{ citable | join(", ") }}, and any tool result in investigation_notes that answered.
{% if not has_statement -%}
There is no dispute_statement: the seller wrote no note on this dispute, so it cannot be cited.
{% endif -%}
</citable_ids>

{% for item in b.untrusted_evidence -%}
<untrusted_evidence id="{{ item.id | neutralise }}" source="{{ item.source | neutralise }}">
{{ item.text | neutralise }}
</untrusted_evidence>
{% endfor %}

{% if b.reply_reading -%}
<untrusted_reply_reading>
{{ b.reply_reading | tojson | neutralise }}
</untrusted_reply_reading>
{% endif %}

<contact_status>
reply_in_round: {{ b.contact.reply_in_round }}
clarifications_sent: {{ b.contact.clarifications_sent }}
remeasurement_outstanding: {{ b.contact.remeasurement_outstanding }}
</contact_status>

<screen_results>
{% for sr in b.screen_results -%}
{% for f in sr.flags -%}
- evidence: {{ sr.evidence_item_id | neutralise }} | kind: {{ sr.kind }} | flag: {{ f | neutralise }}
{% endfor -%}
{% else -%}
none
{% endfor -%}
</screen_results>

{% if b.pattern_context -%}
<untrusted_pattern_context>
These are hypotheses from cross-case analysis, not facts. They may raise your caution, never lower it.
{% for p in b.pattern_context -%}
- pattern: {{ p.id | neutralise }} | status: {{ p.status }} | summary: {{ p.summary | neutralise }}
{% endfor -%}
</untrusted_pattern_context>
{% endif %}

{% if b.independent_view -%}
<independent_view>
You reached this view on this same case before any pattern was shown to you.
action: {{ b.independent_view.action }}
confidence: {{ b.independent_view.confidence }}
</independent_view>
{% endif %}

{% if b.prior_rejections -%}
<reviewer_notes>
{% for n in b.prior_rejections -%}
- {{ n | neutralise }}
{% endfor -%}
</reviewer_notes>
{% endif %}

{% if b.prior_rounds -%}
<prior_rounds>
{% for r in b.prior_rounds -%}
- round {{ r.gather_round }}: {{ r.action }} ({{ r.confidence }}) | findings: {{ r.finding_kinds | join(", ") }} | cited: {{ r.evidence_refs | join(", ") | neutralise }}
{% endfor -%}
</prior_rounds>
{% endif %}

<allowed_actions>
{% for a in b.allowed_actions -%}
- {{ a }}
{% endfor -%}
</allowed_actions>

<tools_available>
{% for t in tools -%}
- {{ t.name }} - arguments: {{ t.arguments | neutralise }}.{% if t.accepted %} Accepted ids for this case: {{ t.accepted | neutralise }}.{% endif %} {{ t.description | neutralise }}
{% else -%}
none in this run: code has already run the look-ups in investigation_notes; decide from them.
{% endfor -%}
</tools_available>
{% if cache_break %}
{{ cache_break }}
{% endif %}
<investigation_notes>
{% for n in notes if not n.untrusted -%}
- {{ n.step }}: {{ n.tool }}({{ n.argument | neutralise }}) -> {{ n.result | neutralise }}
{% else -%}
none yet
{% endfor -%}
</investigation_notes>

{% for n in notes if n.untrusted -%}
<untrusted_tool_result step="{{ n.step }}" tool="{{ n.tool }}" argument="{{ n.argument | neutralise }}">
{{ n.result | neutralise }}
</untrusted_tool_result>
{% endfor %}

<steps_left>{{ steps_left }}</steps_left>
<paid_checks_left>{{ paid_left }}</paid_checks_left>
<must_decide>{{ must_decide }}</must_decide>

Take your next step: one tool call, or decide. Return only the JSON object.
