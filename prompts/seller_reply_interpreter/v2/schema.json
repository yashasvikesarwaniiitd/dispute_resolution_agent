{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReplyReading",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "requested_items_status", "claims", "attachments", "manipulation_flags", "unclear", "confidence", "summary", "language"],
  "properties": {
    "intent": {
      "type": "string",
      "enum": ["provides_requested_evidence", "partial_evidence", "disputes_again_no_new_info", "withdraws_dispute", "asks_question", "irrelevant", "contains_instruction_attempt"]
    },
    "requested_items_status": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "status", "evidence_quote"],
        "properties": {
          "item": {"type": "string"},
          "status": {"type": "string", "enum": ["provided", "partial", "missing"]},
          "evidence_quote": {"type": "string", "maxLength": 200}
        }
      }
    },
    "claims": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "refers_to", "text", "unit_as_written", "certainty"],
        "properties": {
          "kind": {"type": "string", "enum": ["weight", "dimensions", "packaging", "date", "other"]},
          "refers_to": {"type": "string", "enum": ["this_parcel", "product_listing", "other_shipment", "unclear"]},
          "text": {"type": "string", "maxLength": 200},
          "unit_as_written": {"type": "string"},
          "certainty": {"type": "string", "enum": ["stated", "hedged"]}
        }
      }
    },
    "attachments": {"type": "array", "items": {"type": "string"}},
    "manipulation_flags": {"type": "array", "items": {"type": "string"}},
    "unclear": {"type": "array", "maxItems": 5, "items": {"type": "string", "maxLength": 200}},
    "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
    "summary": {"type": "string", "maxLength": 300},
    "language": {"type": "string"}
  }
}
