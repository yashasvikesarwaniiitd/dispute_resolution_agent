# Names only. Put real values in .env (git-ignored). Never paste values into chat.

# Microsoft Foundry (Entra ID only; no API keys)
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL_DEPLOYMENT=
# Microsoft Entra ID > Overview > Tenant ID. Sign in once with `make foundry-login`.
AZURE_TENANT_ID=
# Off unless you are knowingly testing a prompt that has not passed its eval suite (ADR 0029)
PROMPTS_ALLOW_INACTIVE=false
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Secondary model: Anthropic API (Haiku only). The only API key in the project.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_HAIKU=claude-haiku-5-5
LLM_SECONDARY_SPEND_CAP_USD=10

# Azure free-account credit window (30 days from sign-up)
AZURE_CREDIT_EXPIRES_ON=
LLM_ALLOW_PAID_USAGE=false

# Outlook through Microsoft Graph: personal Outlook.com pilot account, delegated sign-in (ADR 0023)
# Public client: there is no client secret. Sign in once with `make email-login`.
GRAPH_CLIENT_ID=
GRAPH_AUTHORITY=https://login.microsoftonline.com/consumers/
GRAPH_MAILBOX=
# The cache FILE is a secret (encrypted with DPAPI); the folder is git-ignored
GRAPH_TOKEN_CACHE_PATH=data/msal_cache.bin
TEST_SELLER_EMAIL=

# Jira Cloud (test project)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# Review console (local session secret; ADR 0018). Never logged.
REVIEW_CONSOLE_TOKEN=

# App
HTTP_TIMEOUT_S=30
APP_ENV=local
KILL_SWITCH=false
TELEMETRY_CAPTURE_CONTENT=false
LLM_PRIMARY_SPEND_CAP_USD=150
